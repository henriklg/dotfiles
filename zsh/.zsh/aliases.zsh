# Navigation
alias pd="pwd"
alias hy="history"
alias home='cd'
alias doc='cd ~/Documents'
alias down='cd ~/Downloads'
alias pix='cd ~/Pictures'
alias dev='cd ~/dev'

# ls — prefer eza > exa > built-in
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Misc
alias x='exit'
alias py="python3"
alias ollama="$HOME/Applications/ollama"

# git
alias gst="git status -sb"
alias gdi="git diff"
alias gpu="git push"
alias gfe="git fetch"
alias gpl="git pull"
alias gch="git checkout"
alias gco="git commit -m"
alias gad="git add"
alias grm="git rm"
alias gmv="git mv"
alias glo="git log"
alias gtr="git log --graph --oneline --decorate"
